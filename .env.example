# Copy to .env (git-ignored) in the project root; docker-compose reads it automatically.

# Paystack test-mode secret key (sk_test_...) from dashboard.paystack.com
PAYSTACK_SECRET_KEY=

# OpenWeatherMap API key from openweathermap.org
WEATHER_API_KEY=

# Host port for Postgres. Change it if 5432 is already in use on your machine.
POSTGRES_HOST_PORT=5432
